        {
          "id": "4c411209-e007-42ef-944b-f6f542912d96",
          "name": "Get resource usage for a Devbox.",
          "request": {
            "name": "Get resource usage for a Devbox.",
            "description": {
              "content": "Get resource usage metrics for a specific Devbox. Returns CPU, memory, and disk consumption calculated from the Devbox's lifecycle, excluding any suspended periods for CPU and memory. Disk usage includes the full elapsed time since storage is consumed even when suspended.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1",
                "devboxes",
                ":id",
                "usage"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
