          "id": "9eef7184-3420-43ee-a437-3c4463a426af",
          "name": "Create an ephemeral PTY tunnel for a running Devbox.",
          "request": {
            "name": "Create an ephemeral PTY tunnel for a running Devbox.",
            "description": {
              "content": "Create an ephemeral authenticated tunnel for terminal access to a running Devbox. This tunnel is not persisted on the Devbox and is generated fresh on each request. The returned auth_token must be passed as a Bearer token in the Authorization header.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1",
                "devboxes",
                ":id",
                "create_pty_tunnel"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
