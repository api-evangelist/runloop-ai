        {
          "id": "7938bc4c-6525-4112-b7f5-86dcdb9d6f6d",
          "name": "Enable a tunnel for a running Devbox.",
          "request": {
            "name": "Enable a tunnel for a running Devbox.",
            "description": {
              "content": "Enable a V2 tunnel for an existing running Devbox. Tunnels provide encrypted URL-based access to the Devbox without exposing internal IDs. The tunnel URL format is: https://&#123;port&#125;-&#123;tunnel_key&#125;.tunnel.runloop.ai\n\nEach Devbox can have one tunnel.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1",
                "devboxes",
                ":id",
                "enable_tunnel"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "id",
                  "description": "(Required) The Devbox ID."
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"auth_mode\": \"<string>\",\n  \"http_keep_alive\": \"<boolean>\",\n  \"wake_on_http\": \"<boolean>\"\n}",
